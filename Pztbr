// Parámetros generales
thickness = 0.50; // Espesor general
radius_fillet = 0.12; // Redondeo y filete R.12 aproximado
radius_corner = 0.50; // Cantos redondeados R.50

module orificio_A() {
    translate([1.25, 1.38, 0])
        cylinder(h=thickness, d=1.00, center=false);
}

module orificio_B() {
    // Orificio B: Ø0.281, avellanado, posición 2.25, 0.94
    translate([2.25, 0.94, 0])
    difference() {
        cylinder(h=thickness, d=0.281, center=false);
        // Avellanado simplificado
        translate([0,0,thickness-0.10]) cylinder(h=0.10, d1=0.50, d2=0.281, center=false);
    }
}

module orificio_C() {
    // Orificio C avellanado, posición 1.12, 3.50
    translate([1.12, 3.50, 0])
    difference() {
        cylinder(h=thickness, d=0.281, center=false);
        translate([0,0,thickness-0.10]) cylinder(h=0.10, d1=0.50, d2=0.281, center=false);
    }
}

module orificio_D(x, y) {
    translate([x, y, 0])
    cylinder(h=thickness, d=0.31, center=false);
}

module orificio_E() {
    // 500-13 UNC-2B (se simplifica con diámetro 0.50)
    translate([2.62, 0.75, 0])
    cylinder(h=thickness*1.5, d=0.50, center=false);
}

module runa_F(x, y) {
    translate([x, y, 0])
    cylinder(h=thickness, d=0.50, center=false);
}

module ranura_G() {
    // G: 0.12 atravesado en posición (3.00, 0.75)
    translate([3.00, 0.75, 0])
    cube([0.12, 0.50, thickness+0.1], center=false);
}

module base_shape() {
    // Base cuadrada con longitudes 4.75 x 4.00 y espesor
    difference() {
        hull(){
            translate([0, 0, 0])
                cube([4.75, 4.00, thickness], center=false);
            // Recortes y redondeos se simplifican en esta base
        }
    }
}

module vinculo_conector() {
    // Modelo base con orificios y ranuras
    base_shape();
    
    // orificios
    orificio_A();
    orificio_B();
    orificio_C();
    orificio_D(3.50, 0.75);
    orificio_D(3.50, 1.75);
    orificio_E();

    // ranuras F
    runa_F(0.88, 1.00);
    runa_F(1.25, 1.00);
    runa_F(3.25, 1.00);
    runa_F(4.00, 3.00);

    // ranura G
    ranura_G();
}

vinculo_conector();
